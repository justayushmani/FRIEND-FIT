# ============================================
# FriendFit — Environment Variables
# ============================================
# Copy this file to server/.env for local development.
# NEVER commit real credentials to git.

# ---- Storage ----
# "memory" = in-memory store (default for zero-setup demo)
# "postgres" = PostgreSQL with pgvector (requires DATABASE_URL)
DATABASE_MODE=memory
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Server ----
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- AI Provider Selection ----
# "local" = Local open-weight Gemma via Ollama (default)
# "hosted" = Google AI Studio API
AI_MODE=local
# AI_PROVIDER=local

# ---- Local Open-Weight AI (Ollama + Gemma) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b

# ---- Hosted AI Studio (Optional) ----
# Required only if AI_MODE=hosted
# GOOGLE_AI_API_KEY=your_google_ai_key_here
# GOOGLE_AI_MODEL=gemini-3.8-flash

# ---- Voice / Speech-to-Text (Optional) ----
# Optional server-side ElevenLabs Scribe STT
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ---- Observability (Optional) ----
# SENTRY_DSN=your_sentry_dsn_here
