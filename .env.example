# ============================================
# FriendFit — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file.

# ---- Database (Neon PostgreSQL + pgvector) ----
DATABASE_URL=your_database_url

# ---- Google AI Studio (Gemma) ----
GOOGLE_AI_API_KEY=Ayour_google_api_key_here

# ---- ElevenLabs (Voice — optional) ----
ELEVENLABS_API_KEY=your_elevenlab_api_key_here

# ---- Sentry (Observability — optional) ----
SENTRY_DSN=your_sentry_dsn_here

# ---- Server ----
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- App Mode ----
# "local" = local/private inference, "hosted" = Google AI Studio API
AI_MODE=hosted
